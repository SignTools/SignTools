<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script src="/theme.js"></script>
    <title>SignTools</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js"
      integrity="sha384-GNFwBvfVxBkLMJpYMOABq3c+d3KnQxudP/mGPkzpZSTYykLBNsZEnG2D9G/X/+7D"
      crossorigin="anonymous"
    ></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css"
      integrity="sha256-rzXMaro05QBd53CZ36ctTBp3FdKN3Ow0P0gDHcjLCLw="
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/uppy@2.9.3/dist/uppy.min.js"
      integrity="sha256-AwzInV10JlTyQ3D+cm8UeCggCK6dujyU4Gmy4MCDTFo="
      crossorigin="anonymous"
    ></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/uppy@2.9.3/dist/uppy.min.css"
      integrity="sha256-1GDsETbuTbdWsQXcmt8zRLSsQhnVCZAAfPpCdKuiDi8="
      crossorigin="anonymous"
    />
    <style>
      a,
      a:hover {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
      }
      .view-toggle {
        position: relative;
        display: inline-grid;
        grid-template-columns: 1fr 1fr;
        padding: 3px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 50rem;
        user-select: none;
        margin-right: 0.75rem;
      }
      .view-toggle-slider {
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 3px;
        width: calc(50% - 3px);
        border-radius: 50rem;
        background: #fff;
        transition: transform 0.2s ease;
      }
      .view-toggle[data-view="tweaks"] .view-toggle-slider {
        transform: translateX(100%);
      }
      .view-toggle button {
        position: relative;
        z-index: 1;
        min-width: 3.5rem;
        padding: 0.25rem 0.75rem;
        border: 0;
        border-radius: 50rem;
        background: transparent;
        color: #fff;
        transition: color 0.2s ease;
      }
      .view-toggle button.active {
        color: #212529;
      }
      @media (max-width: 575.98px) {
        /* phones: tighten everything so title, slider and actions share one row */
        .view-toggle button {
          min-width: 0;
          padding: 0.25rem 0.85rem;
        }
        .navbar .btn {
          padding: 0.375rem 0.6rem;
        }
      }
      .navbar > .container > :not(.nav-spacer) {
        flex-shrink: 0;
      }
      /* fitNavbar() tiers, tried in order: tight -> icon -> stacked */
      .brand-icon {
        display: none;
        width: 1.5rem;
        height: 1.5rem;
      }
      .navbar.nav-icon .brand-icon {
        display: block;
      }
      .navbar.nav-icon .brand-text {
        display: none;
      }
      .navbar.nav-tight > .container {
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
      }
      .navbar.nav-tight .breadcrumb {
        margin-right: 0.375rem !important;
      }
      .navbar.nav-tight .view-toggle {
        margin-right: 0.5rem;
      }
      .navbar.nav-tight .btn {
        padding-left: 0.5rem;
        padding-right: 0.5rem;
      }
      .navbar.nav-tight .nav-spacer:not(.nav-spacer-end) {
        min-width: 0.375rem;
      }
      /* not enough room on one row: slider gets its own full-width row */
      .navbar.nav-stacked > .container {
        flex-wrap: wrap;
        row-gap: 0.75rem;
      }
      .navbar.nav-stacked .view-toggle {
        order: 1;
        width: 100%;
        margin-right: 0 !important;
      }
      a.help-link {
        color: var(--bs-link-color);
      }
      /* bg-dark matches the dark page background */
      [data-bs-theme="dark"] .bg-dark {
        background-color: var(--bs-tertiary-bg) !important;
      }
      [data-bs-theme="dark"] .appItem .card {
        --bs-bg-opacity: 0.6;
      }
      a.tweak-count,
      a.tweak-count:hover {
        text-decoration: underline dotted;
        text-underline-offset: 0.25em;
        cursor: help;
      }
      .tweak-tooltip .tooltip-inner {
        white-space: pre-line;
        text-align: left;
      }
      .live-status {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        user-select: none;
      }
      .nav-spacer {
        flex: 0 1 1.5rem;
        min-width: 0.5rem;
      }
      .nav-spacer.nav-spacer-end {
        flex-basis: 0.5rem;
        min-width: 0;
      }
      .live-dot {
        display: inline-block;
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: #6c757d;
        transition: background-color 0.2s ease;
      }
      .live-status[data-state="live"] .live-dot {
        background: #20c997;
        box-shadow: 0 0 0.4rem #20c997;
      }
      .live-status[data-state="offline"] .live-dot {
        background: #ffc107;
      }
      .view-toggle button:focus-visible {
        outline: 2px solid #86b7fe;
        outline-offset: 1px;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-dark bg-dark py-3">
      <div class="container px-3 px-sm-4">
        <ol class="breadcrumb bg-transparent py-2 my-0 me-2 me-sm-3 text-white">
          <li class="breadcrumb-item">
            <a href="/" title="SignTools"
              ><img class="brand-icon" src="/favicon.png" alt="SignTools" /><span class="brand-text"
                >SignTools</span
              ></a
            >
          </li>
        </ol>
        <div class="view-toggle" id="viewToggle" data-view="apps" role="tablist">
          <span class="view-toggle-slider"></span>
          <button
            type="button"
            role="tab"
            data-view="apps"
            class="active"
            aria-selected="true"
            title="Apps"
            aria-label="Apps"
          >
            <i class="bi bi-grid-fill"></i>
          </button>
          <button type="button" role="tab" data-view="tweaks" aria-selected="false" title="Tweaks" aria-label="Tweaks">
            <i class="bi bi-puzzle-fill"></i>
          </button>
        </div>
        <span
          id="liveStatus"
          class="live-status ms-auto text-white-50 small"
          data-state="connecting"
          title="Connecting to server..."
          ><span class="live-dot"></span
          ><span class="d-none d-sm-inline ms-1" id="liveStatusText">Connecting</span></span
        >
        <span class="nav-spacer" aria-hidden="true"></span>
        <button class="btn btn-outline-light my-0 me-2" id="btnTheme" type="button">
          <i class="bi" id="themeIcon"></i>
        </button>
        <a id="btnUploadApp" class="btn btn-outline-light my-0" title="Upload app" aria-label="Upload app"
          ><i class="bi bi-upload"></i
        ></a>
        <a
          id="btnUploadTweaks"
          class="btn btn-outline-light my-0"
          title="Upload tweak"
          aria-label="Upload tweak"
          hidden
          ><i class="bi bi-upload"></i
        ></a>
        <span class="nav-spacer nav-spacer-end d-sm-none" aria-hidden="true"></span>
      </div>
    </nav>
    <div class="modal" id="uploadModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <form id="uploadForm" action="/apps" method="post" enctype="multipart/form-data">
            <div class="modal-header">
              <h5 class="modal-title">Upload App</h5>
              <button id="btnModalClose" type="button" class="btn-close"></button>
            </div>
            <div id="modalBody" class="modal-body">
              <nav>
                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                  <button
                    class="nav-link active"
                    id="nav-main-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#nav-main"
                    type="button"
                    role="tab"
                  >
                    Main
                  </button>
                  <button
                    class="nav-link"
                    id="nav-advanced-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#nav-advanced"
                    type="button"
                    role="tab"
                  >
                    Advanced
                  </button>
                </div>
              </nav>
              <div class="tab-content" id="nav-tabContent">
                <div class="tab-pane active pt-2" id="nav-main" role="tabpanel">
                  <div class="mb-2">
                    <div class="d-flex justify-content-between">
                      <label class="form-label">App file</label>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="formFileUseUrl" />
                        <label class="form-check-label" for="formFileUseUrl">URL</label>
                      </div>
                    </div>
                    <input class="form-control" type="file" id="formFileSelect" required />
                    <input class="form-control" type="text" id="formFileText" hidden disabled />
                    <input
                      class="form-control"
                      type="text"
                      id="formFileUrl"
                      placeholder="https://git.io/myapp.ipa"
                      name="{{.FormFileUrl}}"
                      hidden
                      required
                    />
                    <input
                      class="form-control"
                      type="text"
                      id="formFileId"
                      name="{{.FormFileId}}"
                      hidden
                      required
                      readonly
                    />
                  </div>
                  <div class="mb-2 col-md-8">
                    <label for="formProfile" class="form-label">Signing profile</label>
                    <select class="form-select" id="formProfile" name="{{.FormProfileId}}" required>
                      <option selected disabled value="">Choose...</option>
                      {{range $_, $profile := .Profiles}}
                      <option value="{{$profile.Id}}" account="{{$profile.IsAccount}}">{{$profile.Name}}</option>
                      {{end}}
                    </select>
                  </div>
                  <div class="mb-2 col-md-8">
                    <label for="formBuilder" class="form-label">Builder</label>
                    <select class="form-select" id="formBuilder" name="{{.FormBuilderId}}" required>
                      {{range $_, $builder := .Builders}}
                      <option value="{{$builder.Id}}">{{$builder.Name}}</option>
                      {{end}}
                    </select>
                  </div>
                  <div class="mb-2 col-md-9">
                    <label class="form-label">Bundle identifier</label>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        id="formIdOriginal"
                        name="{{.FormId}}"
                        value="{{.FormIdOriginal}}"
                        checked
                      />
                      <label style="display: inline" class="form-check-label" for="formIdOriginal">
                        Use app's original bundle ID
                      </label>
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        id="formIdProv"
                        name="{{.FormId}}"
                        value="{{.FormIdProv}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formIdProv">
                        Use provisioning profile's application ID
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Fixes entitlements with explicit provisioning profiles.
                                For each profile, only one app signed this way can be installed at a time."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        id="formIdCustom"
                        name="{{.FormId}}"
                        value="{{.FormIdCustom}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formIdCustom"> Use custom: </label>
                      <input
                        type="text"
                        class="form-control"
                        name="{{.FormIdCustomText}}"
                        disabled
                        id="formIdCustomText"
                        placeholder="com.custom.app"
                        required
                      />
                    </div>
                  </div>
                </div>
                <div class="tab-pane pt-2" id="nav-advanced" role="tabpanel">
                  <div class="mb-2 col-md-8">
                    <label for="formBundleName" class="form-label">Bundle name (optional)</label>
                    <a
                      class="help-link"
                      data-bs-toggle="tooltip"
                      data-bs-placement="right"
                      title="The app's name on the home screen. Leave empty for unchanged."
                      >?</a
                    >
                    <input
                      type="text"
                      class="form-control"
                      name="{{.FormBundleName}}"
                      id="formBundleName"
                      placeholder="My Custom App"
                    />
                  </div>
                  <div class="mb-2">
                    <label class="form-label">ID options</label>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formIdEncode"
                        name="{{.FormIdEncode}}"
                        disabled
                      />
                      <label style="display: inline" class="form-check-label" for="formIdEncode">
                        Encode original IDs to unique IDs
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Allows you to sign apps whose IDs you do not own."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formIdPatch"
                        name="{{.FormIdPatch}}"
                        checked
                      />
                      <label style="display: inline" class="form-check-label" for="formIdPatch">
                        Patch new IDs into app's binaries
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Fixes cases where the app expects its old IDs. Disable this if you have issues."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formIdForceOriginal"
                        name="{{.FormIdForceOriginal}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formIdForceOriginal">
                        Force original bundle ID
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Fixes push notifications. Requires distribution certificate. Can break entitlements."
                        >?</a
                      >
                    </div>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Additional options</label>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="formAppDebug" name="{{.FormAppDebug}}" />
                      <label style="display: inline" class="form-check-label" for="formAppDebug">
                        Enable app debugging
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Necessary for some emulators and jailbreaks. Requires development certificate."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formAllDevices"
                        checked
                        name="{{.FormAllDevices}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formAllDevices">
                        Force enable support for all devices
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Removes any iOS version or device model restrictions from the app."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="formMac" name="{{.FormMac}}" />
                      <label style="display: inline" class="form-check-label" for="formMac">
                        Apply patches for Mac
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Applies patches that make the app work better on Mac, such as freeform window resizing."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="formFileShare" name="{{.FormFileShare}}" />
                      <label style="display: inline" class="form-check-label" for="formFileShare">
                        Force enable file sharing
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Allows you to access the app's data via the Files app, iTunes, and other file managers."
                        >?</a
                      >
                    </div>
                  </div>
                  <div class="mb-0">
                    <div class="d-flex justify-content-between">
                      <div>
                        <label class="form-label">Tweaks (optional)</label>
                        <a
                          class="help-link"
                          data-bs-toggle="tooltip"
                          data-bs-placement="right"
                          title="Injects tweaks into the app. Does not always work."
                          >?</a
                        >
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="formTweaksUseLibrary" />
                        <label class="form-check-label" for="formTweaksUseLibrary">Library</label>
                      </div>
                    </div>
                    <!-- a fieldset so toggling can disable the picker even after live updates replace it -->
                    <fieldset id="savedTweaksContainer" hidden disabled>
                      {{block "savedTweaks" .}} {{if .Tweaks}}
                      <div class="dropdown" id="savedTweaksDropdown">
                        <button
                          class="form-select text-start text-truncate"
                          type="button"
                          id="savedTweaksButton"
                          data-bs-toggle="dropdown"
                          data-bs-auto-close="outside"
                          aria-expanded="false"
                        >
                          Select saved tweaks...
                        </button>
                        <div class="dropdown-menu w-100 p-0" aria-labelledby="savedTweaksButton">
                          <div class="p-2 border-bottom">
                            <input
                              type="search"
                              class="form-control form-control-sm"
                              id="savedTweaksSearch"
                              placeholder="Search tweaks"
                              autocomplete="off"
                            />
                          </div>
                          <div style="max-height: 12rem; overflow-y: auto" class="py-1">
                            {{range $_, $tweak := .Tweaks}}
                            <label class="dropdown-item d-flex align-items-center savedTweakOption">
                              <input
                                class="form-check-input mt-0 me-2 flex-shrink-0"
                                type="checkbox"
                                name="{{$.FormSavedTweakIds}}"
                                value="{{$tweak.Id}}"
                              />
                              <span class="savedTweakName text-truncate" title="{{$tweak.Name}}">{{$tweak.Name}}</span>
                            </label>
                            {{end}}
                            <div class="dropdown-item-text text-muted small" id="savedTweaksNoMatch" hidden>
                              No matching tweaks
                            </div>
                          </div>
                        </div>
                      </div>
                      {{else}}
                      <div class="form-text">
                        No saved tweaks. Add some in the
                        <a href="#tweaks" id="linkTweaksView" class="help-link">Tweaks</a> view.
                      </div>
                      {{end}} {{end}}
                    </fieldset>
                    <input class="form-control" type="file" id="formTweaksSelect" multiple />
                    <input
                      class="form-control"
                      type="text"
                      id="formTweakIds"
                      name="{{.FormTweakIds}}"
                      hidden
                      required
                      readonly
                    />
                  </div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <div
                id="formFileSpinner"
                class="spinner-border text-primary me-3"
                role="status"
                style="display: none"
              ></div>
              <button id="formSubmit" type="button" class="btn btn-primary">Submit</button>
              <div class="UppyProgressBar"></div>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="modal" id="tweakModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <form id="tweakForm">
            <div class="modal-header">
              <h5 class="modal-title">Upload Tweak</h5>
              <button id="btnTweakModalClose" type="button" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <label for="tweakSelect" class="form-label">Tweak file</label>
              <input class="form-control" type="file" id="tweakSelect" multiple required />
            </div>
            <div class="modal-footer">
              <div
                id="tweakSpinner"
                class="spinner-border text-primary me-3"
                role="status"
                style="display: none"
              ></div>
              <button id="tweakSubmit" type="button" class="btn btn-primary">Submit</button>
              <div class="TweakProgressBar"></div>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="container py-4 py-xxl-5 py-xl-5 px-4">
      <div class="row col-md-8 col-l-7 col-xl-6 px-0 mx-auto pb-3">
        <div class="input-group px-0">
          <input type="text" id="inputSearchFilter" class="form-control" placeholder="Search app name" autofocus />
          <button
            class="btn btn-outline-secondary"
            id="btnSearchClear"
            type="button"
            title="Clear search"
            aria-label="Clear search"
          >
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      </div>
      <div id="viewTweaks" hidden>
        <p class="text-muted text-center py-4" id="tweaksEmpty" {{if .Tweaks}}hidden{{end}}>
          No saved tweaks yet. Use the <i class="bi bi-upload"></i> button to add some, then turn on <b>Library</b> in
          the Advanced tab when signing to pick them.
        </p>
        <div class="row" id="masonryTweaksRow">
          <div class="col-sm-6 col-lg-4 col-xl-3 p-2" id="tweakSizeItem"></div>
          {{block "tweaks" .}} {{range $_, $tweak := .Tweaks}}
          <div class="col-sm-6 col-lg-4 col-xl-3 p-2 tweakItem" data-id="{{$tweak.Id}}">
            <div class="card text-white bg-dark">
              <div class="card-body">
                <div class="row">
                  <div class="col pe-0">
                    <h5 class="card-title" style="word-break: break-all">{{$tweak.Name}}</h5>
                  </div>
                  <div class="col-auto">
                    <div class="dropdown">
                      <a class="bi bi-three-dots-vertical py-1 px-2" data-bs-toggle="dropdown"></a>
                      <div class="dropdown-menu">
                        <a class="dropdown-item" href="{{$tweak.RenameUrl}}">Rename...</a>
                        <a
                          class="dropdown-item"
                          href="{{$tweak.DeleteUrl}}"
                          data-action="delete"
                          data-confirm='Delete tweak "{{$tweak.Name}}"?'
                          >Delete</a
                        >
                      </div>
                    </div>
                  </div>
                </div>
                <p class="card-text mb-2">
                  Tweak <br />
                  {{$tweak.Size}} <br />
                  {{$tweak.ModTime}}
                </p>
                <div class="d-flex flex-wrap justify-content-end">
                  <a class="btn btn-outline-light mt-2 ms-2" href="{{$tweak.DownloadUrl}}">Download</a>
                </div>
              </div>
            </div>
          </div>
          {{end}} {{end}}
        </div>
      </div>
      <div class="row" id="masonryRow">
        <div class="col-sm-6 col-lg-4 col-xl-3 p-2" id="appSizeItem"></div>
        {{block "apps" .}} {{range $_, $app := .Apps}}
        <div class="col-sm-6 col-lg-4 col-xl-3 p-2 appItem" data-id="{{$app.Id}}">
          <div
            class="card text-white
                    {{if eq $app.Status 0 }} bg-primary
                    {{else if eq $app.Status 1 }} bg-success
                    {{else if eq $app.Status 2 }} bg-danger
                    {{else if eq $app.Status 3 }} bg-secondary
                    {{end}}"
          >
            <div class="card-body">
              <div class="row">
                <div class="col pe-0">
                  <h5 class="card-title" style="word-break: break-all">{{$app.Name}}</h5>
                </div>
                <div class="col-auto">
                  <div class="dropdown">
                    <a class="bi bi-three-dots-vertical py-1 px-2" data-bs-toggle="dropdown"></a>
                    <div class="dropdown-menu">
                      <a class="dropdown-item dropdownCreateFrom" x-app-name="{{$app.Name}}" x-app-id="{{$app.Id}}"
                        >Create from...</a
                      >
                      <a class="dropdown-item" href="{{$app.RenameUrl}}">Rename...</a>
                      <a class="dropdown-item" href="{{$app.ResignUrl}}" data-action="resign">Resign</a>
                      <a
                        class="dropdown-item"
                        href="{{$app.DeleteUrl}}"
                        data-action="delete"
                        data-confirm='Delete app "{{$app.Name}}"?'
                        >Delete</a
                      >
                    </div>
                  </div>
                </div>
              </div>
              <p class="card-text mb-2">
                {{if gt $app.TweakCount 0}}
                <a class="tweak-count" tabindex="0" role="button" data-bs-title="{{$app.TweakNames}}"
                  >{{$app.TweakCount}} tweaks</a
                >
                <br />
                {{end}} {{if eq $app.Status 1 }} {{$app.BundleId}} <br />
                {{end}} {{$app.ProfileName}} <br />
                {{if eq $app.Status 0 }} Processing {{else if eq $app.Status 1 }} Signed {{else if eq $app.Status 2 }}
                Failed {{else if eq $app.Status 3 }} Waiting {{end}} <br />
                {{$app.ModTime}}
              </p>
              <div class="d-flex flex-wrap justify-content-end">
                {{if eq $app.Status 1 }}
                <a class="btn btn-outline-light mt-2 ms-2" href="{{$app.InstallUrl}}">Install</a>
                {{end}} {{if ne $app.Status 1 }}
                <a
                  class="btn btn-outline-light mt-2 ms-2 {{if lt (len $app.WorkflowUrl) 1}}disabled{{end}}"
                  href="{{$app.WorkflowUrl}}"
                  >Status</a
                >
                {{end}} {{if or (eq $app.Status 0) (eq $app.Status 3)}}
                <a class="btn btn-outline-light mt-2 ms-2" href="{{$app.TwoFactorUrl}}">Submit 2FA</a>
                {{end}} {{if or (eq $app.Status 1) (eq $app.Status 2)}}
                <div class="dropdown">
                  <a class="btn btn-outline-light mt-2 ms-2 dropdown-toggle" data-bs-toggle="dropdown">Download</a>
                  <ul class="dropdown-menu">
                    {{if eq $app.Status 1 }}
                    <li><a class="dropdown-item" href="{{$app.DownloadSignedUrl}}">Signed</a></li>
                    {{end}}
                    <li><a class="dropdown-item" href="{{$app.DownloadUnsignedUrl}}">Original</a></li>
                    {{if gt $app.TweakCount 0}}
                    <li><a class="dropdown-item" href="{{$app.DownloadTweaksUrl}}">Tweaks</a></li>
                    {{end}}
                  </ul>
                </div>
                {{end}}
              </div>
            </div>
          </div>
        </div>
        {{end}} {{end}}
      </div>
    </div>
  </body>

  <script>
    const btnUploadApp = document.getElementById("btnUploadApp");
    const formFileSelect = document.getElementById("formFileSelect");
    const formFileId = document.getElementById("formFileId");
    const formFileText = document.getElementById("formFileText");
    const formFileUseUrl = document.getElementById("formFileUseUrl");
    const formFileUrl = document.getElementById("formFileUrl");
    const formTweakIds = document.getElementById("formTweakIds");
    const formTweaksSelect = document.getElementById("formTweaksSelect");
    const formTweaksUseLibrary = document.getElementById("formTweaksUseLibrary");
    const formSubmit = document.getElementById("formSubmit");
    const uploadForm = document.getElementById("uploadForm");
    const modalBody = document.getElementById("modalBody");
    const formFileSpinner = document.getElementById("formFileSpinner");
    const modalElem = document.getElementById("uploadModal");
    const modal = new bootstrap.Modal(modalElem, {
      backdrop: "static",
      keyboard: false,
    });
    const btnModalClose = document.getElementById("btnModalClose");
    const formProfile = document.getElementById("formProfile");
    const formIdOriginal = document.getElementById("formIdOriginal");
    const formIdProv = document.getElementById("formIdProv");
    const formIdCustom = document.getElementById("formIdCustom");
    const formIdCustomText = document.getElementById("formIdCustomText");
    const formIdEncode = document.getElementById("formIdEncode");
    const formIdPatch = document.getElementById("formIdPatch");
    const inputSearchFilter = document.getElementById("inputSearchFilter");
    const btnSearchClear = document.getElementById("btnSearchClear");
    const liveStatus = document.getElementById("liveStatus");
    const liveStatusText = document.getElementById("liveStatusText");
    const masonryRow = document.getElementById("masonryRow");
    const masonryTweaksRow = document.getElementById("masonryTweaksRow");
    const tweaksEmpty = document.getElementById("tweaksEmpty");
    const savedTweaksContainer = document.getElementById("savedTweaksContainer");

    // captured before Masonry adds its inline styles, to detect which cards changed
    const cardHtml = new WeakMap();
    for (let el of document.querySelectorAll(".appItem, .tweakItem")) {
      cardHtml.set(el, el.outerHTML);
    }

    const masonry = new Masonry(masonryRow, {
      percentPosition: true,
      horizontalOrder: true,
      itemSelector: ".appItem",
      columnWidth: "#appSizeItem",
    });
    const navMain = new bootstrap.Tab(document.getElementById("nav-main-tab"));
    const viewToggle = document.getElementById("viewToggle");
    const viewTweaks = document.getElementById("viewTweaks");
    const masonryTweaks = new Masonry(masonryTweaksRow, {
      percentPosition: true,
      horizontalOrder: true,
      itemSelector: ".tweakItem",
      columnWidth: "#tweakSizeItem",
    });
    const btnUploadTweaks = document.getElementById("btnUploadTweaks");
    const tweakSelect = document.getElementById("tweakSelect");
    const tweakForm = document.getElementById("tweakForm");
    const tweakSubmit = document.getElementById("tweakSubmit");
    const tweakSpinner = document.getElementById("tweakSpinner");
    const btnTweakModalClose = document.getElementById("btnTweakModalClose");
    const tweakModal = new bootstrap.Modal(document.getElementById("tweakModal"), {
      backdrop: "static",
      keyboard: false,
    });

    // X-Requested-With gets a 204 instead of a redirect; following redirects would hide e.g. a proxy login bounce
    async function request(url, options = {}) {
      const res = await fetch(url, {
        credentials: "same-origin",
        redirect: "manual",
        ...options,
        headers: { "X-Requested-With": "fetch" },
      });
      if (res.ok) return;
      let message = res.type === "opaqueredirect" ? "Unexpected redirect" : await res.text();
      try {
        message = JSON.parse(message).message || message;
      } catch (_) {}
      throw new Error(message || `${res.status} ${res.statusText}`);
    }

    function reportError(err) {
      console.error(err);
      alert(err.message || err);
    }

    function uploadIds(result, uploadType) {
      if (result.failed.length > 0) {
        throw new Error(result.failed.map((f) => f.error).join("\n"));
      }
      return result.successful
        .filter((f) => !uploadType || f.meta.uploadType === uploadType)
        .map((f) => f.uploadURL.split("/").pop());
    }

    const navbar = document.querySelector(".navbar");
    const navbarRow = navbar.querySelector(".container");
    const navbarTiers = [[], ["nav-tight"], ["nav-tight", "nav-icon"], ["nav-stacked"]];
    function fitNavbar() {
      // the last tier always fits
      for (const tier of navbarTiers) {
        navbar.classList.remove("nav-tight", "nav-icon", "nav-stacked");
        navbar.classList.add(...tier);
        if (navbarRow.scrollWidth <= navbarRow.clientWidth) return;
      }
    }
    let navbarWidth = 0;
    new ResizeObserver(() => {
      // only refit on width changes; stacking changes the height and would retrigger
      if (navbar.clientWidth === navbarWidth) return;
      navbarWidth = navbar.clientWidth;
      fitNavbar();
    }).observe(navbar);
    document.fonts.ready.then(fitNavbar);

    function setView(view) {
      if (view !== "tweaks") view = "apps";
      viewToggle.dataset.view = view;
      for (let btn of viewToggle.querySelectorAll("button")) {
        const active = btn.dataset.view === view;
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-selected", active);
      }
      const isTweaks = view === "tweaks";
      masonryRow.hidden = isTweaks;
      viewTweaks.hidden = !isTweaks;
      btnUploadApp.hidden = isTweaks;
      btnUploadTweaks.hidden = !isTweaks;
      inputSearchFilter.placeholder = isTweaks ? "Search tweak name" : "Search app name";
      fitNavbar();
      history.replaceState(null, "", isTweaks ? "#tweaks" : location.pathname + location.search);
      // the newly shown grid was laid out while hidden (zero width), so snap it into
      // place instead of animating every card from the corner
      applySearchFilter(true);
    }
    for (let btn of viewToggle.querySelectorAll("button")) {
      btn.addEventListener("click", () => setView(btn.dataset.view));
    }
    window.addEventListener("hashchange", () => setView(location.hash.slice(1)));

    // re-run whenever a live update replaces the picker
    let updateSavedTweaksSummary = () => {};
    function initSavedTweaks() {
      const dropdown = document.getElementById("savedTweaksDropdown");
      if (!dropdown) {
        updateSavedTweaksSummary = () => {};
        return;
      }
      const button = document.getElementById("savedTweaksButton");
      const search = document.getElementById("savedTweaksSearch");
      const noMatch = document.getElementById("savedTweaksNoMatch");
      const options = [...dropdown.getElementsByClassName("savedTweakOption")];
      updateSavedTweaksSummary = () => {
        const names = options
          .filter((o) => o.querySelector("input").checked)
          .map((o) => o.querySelector(".savedTweakName").textContent.trim());
        if (names.length === 0) button.textContent = "Select saved tweaks...";
        else if (names.length === 1) button.textContent = names[0];
        else button.textContent = `${names.length} files`;
        button.title = names.join("\n");
      };
      for (let o of options) o.querySelector("input").addEventListener("change", updateSavedTweaksSummary);
      search.addEventListener("input", () => {
        const q = search.value.toLowerCase();
        let visible = 0;
        for (let o of options) {
          const match = o.querySelector(".savedTweakName").textContent.toLowerCase().includes(q);
          o.classList.toggle("d-none", !match);
          if (match) visible++;
        }
        noMatch.hidden = visible > 0;
      });
      // don't submit the form on Enter in the search box
      search.addEventListener("keydown", (e) => {
        if (e.key === "Enter") e.preventDefault();
      });
      dropdown.addEventListener("shown.bs.dropdown", () => search.focus());
      dropdown.addEventListener("hidden.bs.dropdown", () => {
        search.value = "";
        search.dispatchEvent(new Event("input"));
      });
      updateSavedTweaksSummary();
    }
    initSavedTweaks();

    const tweakUppy = new Uppy.Core({ id: "tweaks", autoProceed: false });
    tweakUppy.use(Uppy.ProgressBar, {
      target: ".TweakProgressBar",
      fixed: true,
      hideAfterFinish: false,
    });
    tweakUppy.use(Uppy.Tus, {
      endpoint: "/tus/",
      parallelUploads: 6,
    });
    function setTweakSubmitting(submitting) {
      tweakSubmit.disabled = submitting;
      btnTweakModalClose.disabled = submitting;
      tweakSpinner.style.display = submitting ? "inline-block" : "none";
    }
    function resetTweakForm() {
      tweakUppy.cancelAll();
      tweakForm.reset();
    }
    btnUploadTweaks.addEventListener("click", () => {
      resetTweakForm();
      tweakModal.show();
    });
    btnTweakModalClose.addEventListener("click", () => tweakModal.hide());
    tweakSelect.addEventListener("change", (event) => {
      tweakUppy.cancelAll();
      for (let file of event.target.files) {
        try {
          tweakUppy.addFile({ name: file.name, type: file.type, data: file });
        } catch (err) {
          reportError(err);
        }
      }
    });
    tweakSubmit.addEventListener("click", () => {
      if (!tweakForm.reportValidity()) return;
      setTweakSubmitting(true);
      tweakUppy
        .upload()
        .then(async (result) => {
          const body = new URLSearchParams({ "{{.FormTweakIds}}": uploadIds(result).join(",") });
          await request("/tweaks", { method: "POST", body });
          tweakModal.hide();
          resetTweakForm();
        })
        .catch((err) => {
          // finished uploads may already be consumed by the server, so start over
          resetTweakForm();
          reportError(err);
        })
        .finally(() => setTweakSubmitting(false));
    });

    const uppy = new Uppy.Core();
    uppy.use(Uppy.ProgressBar, {
      target: ".UppyProgressBar",
      fixed: true,
      hideAfterFinish: false,
    });
    uppy.use(Uppy.Tus, {
      endpoint: "/tus/",
      parallelUploads: 6,
    });

    function addTusFileHook(formItem, uploadType) {
      formItem.addEventListener("change", (event) => {
        uppy
          .getFiles()
          .filter((f) => f.meta["uploadType"] === uploadType)
          .forEach((f) => uppy.removeFile(f.id));
        for (let file of event.target.files) {
          try {
            uppy.addFile({
              name: file.name,
              type: file.type,
              data: file,
              meta: {
                uploadType: uploadType,
              },
            });
          } catch (err) {
            reportError(err);
            formItem.value = "";
          }
        }
      });
    }

    addTusFileHook(formFileSelect, "ipa");
    addTusFileHook(formTweaksSelect, "tweak");

    modalElem.addEventListener("shown.bs.modal", function () {
      modalBody.style.minHeight = `30.5rem`;
    });

    // the server consumes uploads even when signing fails, so they can't be reused
    function resetUploads() {
      uppy.cancelAll();
      formFileSelect.value = "";
      formTweaksSelect.value = "";
      formTweakIds.value = "";
      if (formFileText.hidden) formFileId.value = "";
    }

    function resetUploadForm() {
      uploadForm.reset();
      resetUploads();
      formIdCustomText.disabled = true;
      formProfile.dispatchEvent(new Event("change"));
      formTweaksUseLibrary.dispatchEvent(new Event("change"));
      updateSavedTweaksSummary();
      navMain.show();
    }

    function setSubmitting(submitting) {
      formSubmit.disabled = submitting;
      btnModalClose.disabled = submitting;
      formFileSpinner.style.display = submitting ? "inline-block" : "none";
    }

    btnUploadApp.addEventListener("click", function () {
      formFileId.value = "";
      formFileText.hidden = true;
      formFileText.value = "";
      formFileSelect.hidden = false;
      formFileSelect.disabled = false;
      formFileUrl.hidden = true;
      formFileUrl.disabled = true;
      formFileUseUrl.disabled = false;
      formFileUseUrl.checked = false;
      modal.show();
    });
    btnModalClose.addEventListener("click", function () {
      modal.hide();
    });
    formSubmit.addEventListener("click", function () {
      if (!uploadForm.checkValidity()) {
        // only first tab has required inputs
        navMain.show();
        uploadForm.reportValidity();
        return;
      }
      setSubmitting(true);

      uppy
        .upload()
        .then(async (result) => {
          if (!formFileId.value) formFileId.value = uploadIds(result, "ipa")[0];
          if (!formTweakIds.value) formTweakIds.value = uploadIds(result, "tweak").join(",");
          await request(uploadForm.action, { method: "POST", body: new FormData(uploadForm) });
          modal.hide();
          resetUploadForm();
        })
        .catch((err) => {
          console.error(err);
          resetUploads();
          alert(`${err.message || err}\n\nPlease select your files again.`);
        })
        .finally(() => setSubmitting(false));
    });

    formTweaksUseLibrary.addEventListener("change", function () {
      const upload = !formTweaksUseLibrary.checked;
      savedTweaksContainer.hidden = upload;
      savedTweaksContainer.disabled = upload;
      formTweaksSelect.hidden = !upload;
      formTweaksSelect.disabled = !upload;
      if (!upload) {
        uppy
          .getFiles()
          .filter((f) => f.meta.uploadType === "tweak")
          .forEach((f) => uppy.removeFile(f.id));
        formTweaksSelect.value = "";
      }
    });
    formFileUseUrl.addEventListener("change", function () {
      formFileSelect.hidden = !formFileSelect.hidden;
      formFileSelect.disabled = !formFileSelect.disabled;
      formFileUrl.hidden = !formFileUrl.hidden;
      formFileUrl.disabled = !formFileUrl.disabled;
    });
    formProfile.addEventListener("change", function () {
      const selectedOption = formProfile.options[formProfile.selectedIndex];
      if (selectedOption.getAttribute("account") === "true") {
        if (formIdProv.checked) {
          formIdOriginal.checked = true;
        }
        formIdProv.disabled = true;
        formIdEncode.checked = true;
        formIdEncode.disabled = false;
      } else {
        formIdProv.disabled = false;
        formIdEncode.checked = false;
        formIdEncode.disabled = true;
      }
    });
    document.querySelectorAll('input[name="{{.FormId}}"]').forEach(function (a) {
      a.addEventListener("change", function () {
        if (formIdCustom.checked) {
          formIdCustomText.disabled = false;
        } else {
          formIdCustomText.disabled = true;
        }
      });
    });

    // delegated, so cards inserted by live updates work too
    document.addEventListener("click", function (e) {
      const createFrom = e.target.closest(".dropdownCreateFrom");
      if (createFrom) {
        formFileId.value = createFrom.getAttribute("x-app-id");
        formFileText.hidden = false;
        formFileText.value = createFrom.getAttribute("x-app-name");
        formFileSelect.hidden = true;
        formFileSelect.disabled = true;
        formFileUrl.hidden = true;
        formFileUrl.disabled = true;
        formFileUseUrl.disabled = true;
        formFileUseUrl.checked = false;
        modal.show();
        return;
      }
      if (e.target.closest("#linkTweaksView")) {
        modal.hide();
        return;
      }
      const action = e.target.closest("a[data-action]");
      if (action) {
        e.preventDefault();
        if (action.dataset.confirm && !confirm(action.dataset.confirm)) return;
        request(action.href).catch(reportError);
      }
    });

    function applySearchFilter(instant = false) {
      const searchText = inputSearchFilter.value.toLowerCase();
      for (let item of document.querySelectorAll(".appItem, .tweakItem")) {
        item.hidden =
          searchText !== "" && !item.querySelector(".card-title").textContent.toLowerCase().includes(searchText);
      }
      for (let m of [masonry, masonryTweaks]) {
        m.options.layoutInstant = instant;
        m.layout();
        delete m.options.layoutInstant;
      }
    }
    inputSearchFilter.addEventListener("input", () => applySearchFilter());

    const searchClearHandler = function () {
      inputSearchFilter.value = "";
      inputSearchFilter.dispatchEvent(new Event("input"));
    };
    inputSearchFilter.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        searchClearHandler();
      }
    });
    btnSearchClear.addEventListener("click", searchClearHandler);

    // enable all tooltips
    for (let el of document.querySelectorAll('[data-bs-toggle="tooltip"]')) {
      new bootstrap.Tooltip(el);
    }

    // created lazily since live updates replace cards; focus is what makes taps work on touch screens
    function showTweakNames(e) {
      const el = e.target.closest(".tweak-count");
      if (!el || bootstrap.Tooltip.getInstance(el)) return;
      bootstrap.Tooltip.getOrCreateInstance(el, { trigger: "hover focus", customClass: "tweak-tooltip" }).show();
    }
    document.addEventListener("mouseover", showTweakNames);
    document.addEventListener("focusin", showTweakNames);

    function disposeTooltips(card) {
      for (const el of card.querySelectorAll(".tweak-count")) {
        bootstrap.Tooltip.getInstance(el)?.dispose();
      }
    }

    // unchanged cards are left alone, so e.g. an open menu stays open
    function patchGrid(row, html, itemClass, m) {
      const tpl = document.createElement("template");
      tpl.innerHTML = html;
      const incoming = [...tpl.content.children].filter((el) => el.classList.contains(itemClass));
      const current = new Map([...row.getElementsByClassName(itemClass)].map((el) => [el.dataset.id, el]));
      let changed = false;
      let prev = row.firstElementChild; // the masonry size item stays first
      for (let next of incoming) {
        const nextHtml = next.outerHTML;
        let el = current.get(next.dataset.id);
        current.delete(next.dataset.id);
        if (el && cardHtml.get(el) !== nextHtml) {
          disposeTooltips(el);
          el.replaceWith(next);
          el = null;
        }
        if (!el) {
          el = next;
          cardHtml.set(el, nextHtml);
          changed = true;
        }
        if (prev.nextElementSibling !== el) {
          prev.after(el);
          changed = true;
        }
        prev = el;
      }
      for (let el of current.values()) {
        disposeTooltips(el);
        el.remove();
        changed = true;
      }
      if (changed) m.reloadItems();
      return changed;
    }

    // deferred while the picker is open, so it doesn't close under the cursor
    let savedTweaksHtml = null;
    let pendingSavedTweaksHtml = null;
    function setSavedTweaks(html) {
      if (html === savedTweaksHtml) return;
      if (savedTweaksContainer.querySelector(".dropdown-menu.show")) {
        pendingSavedTweaksHtml = html;
        return;
      }
      const checked = new Set(
        [...savedTweaksContainer.querySelectorAll("input[type=checkbox]:checked")].map((i) => i.value),
      );
      savedTweaksContainer.innerHTML = html;
      savedTweaksHtml = html;
      for (let input of savedTweaksContainer.querySelectorAll("input[type=checkbox]")) {
        input.checked = checked.has(input.value);
      }
      initSavedTweaks();
    }
    savedTweaksContainer.addEventListener("hidden.bs.dropdown", () => {
      if (pendingSavedTweaksHtml === null) return;
      const html = pendingSavedTweaksHtml;
      pendingSavedTweaksHtml = null;
      setSavedTweaks(html);
    });

    function applyLiveState(state) {
      let changed = patchGrid(masonryRow, state.apps, "appItem", masonry);
      changed = patchGrid(masonryTweaksRow, state.tweaks, "tweakItem", masonryTweaks) || changed;
      tweaksEmpty.hidden = masonryTweaksRow.getElementsByClassName("tweakItem").length > 0;
      setSavedTweaks(state.savedTweaks);
      if (changed) applySearchFilter(true);
    }

    function setLiveStatus(state, text, title) {
      liveStatus.dataset.state = state;
      liveStatusText.textContent = text;
      liveStatus.title = title;
      fitNavbar();
    }

    function connectLive() {
      const events = new EventSource("/events");
      events.addEventListener("open", () => setLiveStatus("live", "Live", "Receiving live updates"));
      events.addEventListener("state", (e) => {
        try {
          applyLiveState(JSON.parse(e.data));
        } catch (err) {
          console.error(err);
        }
      });
      events.addEventListener("error", () => {
        setLiveStatus("offline", "Reconnecting", "Lost connection to server, reconnecting...");
        // the browser retries on its own, except when the server rejected the request
        if (events.readyState === EventSource.CLOSED) {
          events.close();
          setTimeout(connectLive, 5_000);
        }
      });
    }

    const btnTheme = document.getElementById("btnTheme");
    const themeIcon = document.getElementById("themeIcon");
    function updateThemeButton() {
      const dark = theme.current() === "dark";
      themeIcon.className = dark ? "bi bi-moon-stars-fill" : "bi bi-sun-fill";
      const label = `${dark ? "Dark" : "Light"} theme (${theme.isAuto() ? "matching system" : "manual"})`;
      btnTheme.title = `${label}, click to switch`;
      btnTheme.setAttribute("aria-label", btnTheme.title);
    }
    btnTheme.addEventListener("click", () => theme.toggle());
    document.addEventListener("themechange", updateThemeButton);
    updateThemeButton();

    setView(location.hash.slice(1));
    connectLive();
  </script>
</html>
