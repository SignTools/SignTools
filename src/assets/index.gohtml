<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script src="/js/theme.js"></script>
    <title>SignTools</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css" />
    <style>
      a,
      a:hover {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
      }
      .view-toggle {
        position: relative;
        display: inline-grid;
        grid-template-columns: 1fr 1fr;
        padding: 3px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 50rem;
        user-select: none;
        margin-right: 0.75rem;
      }
      .view-toggle-slider {
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 3px;
        width: calc(50% - 3px);
        border-radius: 50rem;
        background: #fff;
        transition: transform 0.2s ease;
      }
      .view-toggle[data-view="tweaks"] .view-toggle-slider {
        transform: translateX(100%);
      }
      .view-toggle button {
        position: relative;
        z-index: 1;
        min-width: 3.5rem;
        padding: 0.25rem 0.75rem;
        border: 0;
        border-radius: 50rem;
        background: transparent;
        color: #fff;
        transition: color 0.2s ease;
      }
      .view-toggle button.active {
        color: #212529;
      }
      @media (max-width: 575.98px) {
        /* phones: tighten everything so title, slider and actions share one row */
        .view-toggle button {
          min-width: 0;
          padding: 0.25rem 0.85rem;
        }
        .navbar .btn {
          padding: 0.375rem 0.6rem;
        }
      }
      .navbar > .container > :not(.nav-spacer) {
        flex-shrink: 0;
      }
      /* fitNavbar() tiers, tried in order: tight -> icon -> stacked */
      .brand-icon {
        display: none;
        width: 1.5rem;
        height: 1.5rem;
      }
      .navbar.nav-icon .brand-icon {
        display: block;
      }
      .navbar.nav-icon .brand-text {
        display: none;
      }
      .navbar.nav-tight > .container {
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
      }
      .navbar.nav-tight .breadcrumb {
        margin-right: 0.375rem !important;
      }
      .navbar.nav-tight .view-toggle {
        margin-right: 0.5rem;
      }
      .navbar.nav-tight .btn {
        padding-left: 0.5rem;
        padding-right: 0.5rem;
      }
      .navbar.nav-tight .nav-spacer:not(.nav-spacer-end) {
        min-width: 0.375rem;
      }
      /* not enough room on one row: slider gets its own full-width row */
      .navbar.nav-stacked > .container {
        flex-wrap: wrap;
        row-gap: 0.75rem;
      }
      .navbar.nav-stacked .view-toggle {
        order: 1;
        width: 100%;
        margin-right: 0 !important;
      }
      a.help-link {
        color: var(--bs-link-color);
      }
      /* bg-dark matches the dark page background */
      [data-bs-theme="dark"] .bg-dark {
        background-color: var(--bs-tertiary-bg) !important;
      }
      [data-bs-theme="dark"] .appItem .card {
        --bs-bg-opacity: 0.6;
      }
      a.tweak-count,
      a.tweak-count:hover {
        text-decoration: underline dotted;
        text-underline-offset: 0.25em;
        cursor: help;
      }
      .tweak-tooltip .tooltip-inner {
        white-space: pre-line;
        text-align: left;
      }
      .app-icon {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        /* same as the title's, so one-line titles get the gap of two-line ones */
        margin-bottom: 0.5rem;
        border-radius: 22.5%;
        overflow: hidden;
        background-color: rgba(255, 255, 255, 0.15);
        font-size: 1.5rem;
      }
      /* with a one-line title this still fits beside the icon */
      .app-version {
        margin-bottom: 0.5rem;
        font-size: 0.875rem;
        line-height: 1.25;
        opacity: 0.75;
        word-break: break-all;
      }
      .app-icon img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .card-footer-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }
      .card-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-left: auto;
      }
      .live-status {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        user-select: none;
      }
      .nav-spacer {
        flex: 0 1 1.5rem;
        min-width: 0.5rem;
      }
      .nav-spacer.nav-spacer-end {
        flex-basis: 0.5rem;
        min-width: 0;
      }
      .live-dot {
        display: inline-block;
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: #6c757d;
        transition: background-color 0.2s ease;
      }
      .live-status[data-state="live"] .live-dot {
        background: #20c997;
        box-shadow: 0 0 0.4rem #20c997;
      }
      .live-status[data-state="offline"] .live-dot {
        background: #ffc107;
      }
      .view-toggle button:focus-visible {
        outline: 2px solid #86b7fe;
        outline-offset: 1px;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-dark bg-dark py-3">
      <div class="container px-3 px-sm-4">
        <ol class="breadcrumb bg-transparent py-2 my-0 me-2 me-sm-3 text-white">
          <li class="breadcrumb-item">
            <a href="/" title="SignTools"
              ><img class="brand-icon" src="/favicon.png" alt="SignTools" /><span class="brand-text"
                >SignTools</span
              ></a
            >
          </li>
        </ol>
        <div class="view-toggle" id="viewToggle" data-view="apps" role="tablist">
          <span class="view-toggle-slider"></span>
          <button
            type="button"
            role="tab"
            data-view="apps"
            class="active"
            aria-selected="true"
            title="Apps"
            aria-label="Apps"
          >
            <i class="bi bi-grid-fill"></i>
          </button>
          <button type="button" role="tab" data-view="tweaks" aria-selected="false" title="Tweaks" aria-label="Tweaks">
            <i class="bi bi-puzzle-fill"></i>
          </button>
        </div>
        <span
          id="liveStatus"
          class="live-status ms-auto text-white-50 small"
          data-state="connecting"
          title="Connecting to server..."
          ><span class="live-dot"></span
          ><span class="d-none d-sm-inline ms-1" id="liveStatusText">Connecting</span></span
        >
        <span class="nav-spacer" aria-hidden="true"></span>
        <button class="btn btn-outline-light my-0 me-2" id="btnTheme" type="button">
          <i class="bi" id="themeIcon"></i>
        </button>
        <a id="btnUploadApp" class="btn btn-outline-light my-0" title="Upload app" aria-label="Upload app"
          ><i class="bi bi-upload"></i
        ></a>
        <a
          id="btnUploadTweaks"
          class="btn btn-outline-light my-0"
          title="Upload tweak"
          aria-label="Upload tweak"
          hidden
          ><i class="bi bi-upload"></i
        ></a>
        <span class="nav-spacer nav-spacer-end d-sm-none" aria-hidden="true"></span>
      </div>
    </nav>
    <div class="modal" id="uploadModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <form id="uploadForm" action="/apps" method="post" enctype="multipart/form-data">
            <div class="modal-header">
              <h5 class="modal-title">Upload App</h5>
              <button id="btnModalClose" type="button" class="btn-close"></button>
            </div>
            <div id="modalBody" class="modal-body">
              <nav>
                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                  <button
                    class="nav-link active"
                    id="nav-main-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#nav-main"
                    type="button"
                    role="tab"
                  >
                    Main
                  </button>
                  <button
                    class="nav-link"
                    id="nav-advanced-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#nav-advanced"
                    type="button"
                    role="tab"
                  >
                    Advanced
                  </button>
                </div>
              </nav>
              <div class="tab-content" id="nav-tabContent">
                <div class="tab-pane active pt-2" id="nav-main" role="tabpanel">
                  <div class="mb-2">
                    <div class="d-flex justify-content-between">
                      <label class="form-label">App file</label>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="formFileUseUrl" />
                        <label class="form-check-label" for="formFileUseUrl">URL</label>
                      </div>
                    </div>
                    <input class="form-control" type="file" id="formFileSelect" required />
                    <input class="form-control" type="text" id="formFileText" hidden disabled />
                    <input
                      class="form-control"
                      type="text"
                      id="formFileUrl"
                      placeholder="https://git.io/myapp.ipa"
                      name="{{.FormFileUrl}}"
                      hidden
                      required
                    />
                    <input
                      class="form-control"
                      type="text"
                      id="formFileId"
                      name="{{.FormFileId}}"
                      hidden
                      required
                      readonly
                    />
                  </div>
                  <div class="mb-2 col-md-8">
                    <label for="formProfile" class="form-label">Signing profile</label>
                    <select class="form-select" id="formProfile" name="{{.FormProfileId}}" required>
                      <option selected disabled value="">Choose...</option>
                      {{range $_, $profile := .Profiles}}
                      <option value="{{$profile.Id}}" account="{{$profile.IsAccount}}">{{$profile.Name}}</option>
                      {{end}}
                    </select>
                  </div>
                  <div class="mb-2 col-md-8">
                    <label for="formBuilder" class="form-label">Builder</label>
                    <select class="form-select" id="formBuilder" name="{{.FormBuilderId}}" required>
                      {{range $_, $builder := .Builders}}
                      <option value="{{$builder.Id}}">{{$builder.Name}}</option>
                      {{end}}
                    </select>
                  </div>
                  <div class="mb-2 col-md-9">
                    <label class="form-label">Bundle identifier</label>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        id="formIdOriginal"
                        name="{{.FormId}}"
                        value="{{.FormIdOriginal}}"
                        checked
                      />
                      <label style="display: inline" class="form-check-label" for="formIdOriginal">
                        Use app's original bundle ID
                      </label>
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        id="formIdProv"
                        name="{{.FormId}}"
                        value="{{.FormIdProv}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formIdProv">
                        Use provisioning profile's application ID
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Fixes entitlements with explicit provisioning profiles.
                                For each profile, only one app signed this way can be installed at a time."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        id="formIdCustom"
                        name="{{.FormId}}"
                        value="{{.FormIdCustom}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formIdCustom"> Use custom: </label>
                      <input
                        type="text"
                        class="form-control"
                        name="{{.FormIdCustomText}}"
                        disabled
                        id="formIdCustomText"
                        placeholder="com.custom.app"
                        required
                      />
                    </div>
                  </div>
                </div>
                <div class="tab-pane pt-2" id="nav-advanced" role="tabpanel">
                  <div class="mb-2 col-md-8">
                    <label for="formBundleName" class="form-label">Bundle name (optional)</label>
                    <a
                      class="help-link"
                      data-bs-toggle="tooltip"
                      data-bs-placement="right"
                      title="The app's name on the home screen. Leave empty for unchanged."
                      >?</a
                    >
                    <input
                      type="text"
                      class="form-control"
                      name="{{.FormBundleName}}"
                      id="formBundleName"
                      placeholder="My Custom App"
                    />
                  </div>
                  <div class="mb-2">
                    <label class="form-label">ID options</label>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formIdEncode"
                        name="{{.FormIdEncode}}"
                        disabled
                      />
                      <label style="display: inline" class="form-check-label" for="formIdEncode">
                        Encode original IDs to unique IDs
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Allows you to sign apps whose IDs you do not own."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formIdPatch"
                        name="{{.FormIdPatch}}"
                        checked
                      />
                      <label style="display: inline" class="form-check-label" for="formIdPatch">
                        Patch new IDs into app's binaries
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Fixes cases where the app expects its old IDs. Disable this if you have issues."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formIdForceOriginal"
                        name="{{.FormIdForceOriginal}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formIdForceOriginal">
                        Force original bundle ID
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Fixes push notifications. Requires distribution certificate. Can break entitlements."
                        >?</a
                      >
                    </div>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Additional options</label>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="formAppDebug" name="{{.FormAppDebug}}" />
                      <label style="display: inline" class="form-check-label" for="formAppDebug">
                        Enable app debugging
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Necessary for some emulators and jailbreaks. Requires development certificate."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="formAllDevices"
                        checked
                        name="{{.FormAllDevices}}"
                      />
                      <label style="display: inline" class="form-check-label" for="formAllDevices">
                        Force enable support for all devices
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Removes any iOS version or device model restrictions from the app."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="formMac" name="{{.FormMac}}" />
                      <label style="display: inline" class="form-check-label" for="formMac">
                        Apply patches for Mac
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Applies patches that make the app work better on Mac, such as freeform window resizing."
                        >?</a
                      >
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="formFileShare" name="{{.FormFileShare}}" />
                      <label style="display: inline" class="form-check-label" for="formFileShare">
                        Force enable file sharing
                      </label>
                      <a
                        class="help-link"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="Allows you to access the app's data via the Files app, iTunes, and other file managers."
                        >?</a
                      >
                    </div>
                  </div>
                  <div class="mb-0">
                    <div class="d-flex justify-content-between">
                      <div>
                        <label class="form-label">Tweaks (optional)</label>
                        <a
                          class="help-link"
                          data-bs-toggle="tooltip"
                          data-bs-placement="right"
                          title="Injects tweaks into the app. Does not always work."
                          >?</a
                        >
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="formTweaksUseLibrary" />
                        <label class="form-check-label" for="formTweaksUseLibrary">Library</label>
                      </div>
                    </div>
                    <!-- a fieldset so toggling can disable the picker even after live updates replace it -->
                    <fieldset id="savedTweaksContainer" hidden disabled>
                      {{block "savedTweaks" .}} {{if .Tweaks}}
                      <div class="dropdown" id="savedTweaksDropdown">
                        <button
                          class="form-select text-start text-truncate"
                          type="button"
                          id="savedTweaksButton"
                          data-bs-toggle="dropdown"
                          data-bs-auto-close="outside"
                          aria-expanded="false"
                        >
                          Select saved tweaks...
                        </button>
                        <div class="dropdown-menu w-100 p-0" aria-labelledby="savedTweaksButton">
                          <div class="p-2 border-bottom">
                            <input
                              type="search"
                              class="form-control form-control-sm"
                              id="savedTweaksSearch"
                              placeholder="Search tweaks"
                              autocomplete="off"
                            />
                          </div>
                          <div style="max-height: 12rem; overflow-y: auto" class="py-1">
                            {{range $_, $tweak := .Tweaks}}
                            <label class="dropdown-item d-flex align-items-center savedTweakOption">
                              <input
                                class="form-check-input mt-0 me-2 flex-shrink-0"
                                type="checkbox"
                                name="{{$.FormSavedTweakIds}}"
                                value="{{$tweak.Id}}"
                              />
                              <span class="savedTweakName text-truncate" title="{{$tweak.Name}}">{{$tweak.Name}}</span>
                            </label>
                            {{end}}
                            <div class="dropdown-item-text text-muted small" id="savedTweaksNoMatch" hidden>
                              No matching tweaks
                            </div>
                          </div>
                        </div>
                      </div>
                      {{else}}
                      <div class="form-text">
                        No saved tweaks. Add some in the
                        <a href="#tweaks" id="linkTweaksView" class="help-link">Tweaks</a> view.
                      </div>
                      {{end}} {{end}}
                    </fieldset>
                    <input class="form-control" type="file" id="formTweaksSelect" multiple />
                    <input
                      class="form-control"
                      type="text"
                      id="formTweakIds"
                      name="{{.FormTweakIds}}"
                      hidden
                      required
                      readonly
                    />
                  </div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <div
                class="progress flex-grow-1 me-3"
                id="uploadProgress"
                role="progressbar"
                aria-label="Upload progress"
                hidden
              >
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
              </div>
              <div
                id="formFileSpinner"
                class="spinner-border text-primary me-3"
                role="status"
                style="display: none"
              ></div>
              <button id="formSubmit" type="button" class="btn btn-primary">Submit</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="modal" id="tweakModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <form id="tweakForm">
            <div class="modal-header">
              <h5 class="modal-title">Upload Tweak</h5>
              <button id="btnTweakModalClose" type="button" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <label for="tweakSelect" class="form-label">Tweak file</label>
              <input class="form-control" type="file" id="tweakSelect" multiple required />
            </div>
            <div class="modal-footer">
              <div
                class="progress flex-grow-1 me-3"
                id="tweakProgress"
                role="progressbar"
                aria-label="Upload progress"
                hidden
              >
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
              </div>
              <div
                id="tweakSpinner"
                class="spinner-border text-primary me-3"
                role="status"
                style="display: none"
              ></div>
              <button id="tweakSubmit" type="button" class="btn btn-primary">Submit</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="container py-4 py-xxl-5 py-xl-5 px-4">
      <div class="row col-md-8 col-l-7 col-xl-6 px-0 mx-auto pb-3">
        <div class="input-group px-0">
          <input type="text" id="inputSearchFilter" class="form-control" placeholder="Search app name" autofocus />
          <button
            class="btn btn-outline-secondary"
            id="btnSearchClear"
            type="button"
            title="Clear search"
            aria-label="Clear search"
          >
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      </div>
      <div id="viewTweaks" hidden>
        <p class="text-muted text-center py-4" id="tweaksEmpty" {{if .Tweaks}}hidden{{end}}>
          No saved tweaks yet. Use the <i class="bi bi-upload"></i> button to add some, then turn on <b>Library</b> in
          the Advanced tab when signing to pick them.
        </p>
        <div class="row" id="masonryTweaksRow">
          <div class="col-sm-6 col-lg-4 col-xl-3 p-2" id="tweakSizeItem"></div>
          {{block "tweaks" .}} {{range $_, $tweak := .Tweaks}}
          <div class="col-sm-6 col-lg-4 col-xl-3 p-2 tweakItem" data-id="{{$tweak.Id}}">
            <div class="card text-white bg-dark">
              <div class="card-body">
                <div class="row">
                  <div class="col pe-0">
                    <h5 class="card-title" style="word-break: break-all">{{$tweak.Name}}</h5>
                  </div>
                  <div class="col-auto">
                    <div class="dropdown">
                      <a class="bi bi-three-dots-vertical py-1 px-2" data-bs-toggle="dropdown"></a>
                      <div class="dropdown-menu">
                        <a class="dropdown-item" href="{{$tweak.RenameUrl}}">Rename...</a>
                        <a
                          class="dropdown-item"
                          href="{{$tweak.DeleteUrl}}"
                          data-action="delete"
                          data-confirm='Delete tweak "{{$tweak.Name}}"?'
                          >Delete</a
                        >
                      </div>
                    </div>
                  </div>
                </div>
                <p class="card-text mb-2">
                  Tweak <br />
                  {{$tweak.Size}}
                </p>
                <div class="card-footer-row">
                  <span>{{$tweak.ModTime}}</span>
                  <div class="card-actions">
                    <a
                      class="btn btn-outline-light"
                      href="{{$tweak.DownloadUrl}}"
                      title="Download"
                      aria-label="Download"
                      ><i class="bi bi-download"></i
                    ></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {{end}} {{end}}
        </div>
      </div>
      <div class="row" id="masonryRow">
        <div class="col-sm-6 col-lg-4 col-xl-3 p-2" id="appSizeItem"></div>
        {{block "apps" .}} {{range $_, $app := .Apps}}
        <div class="col-sm-6 col-lg-4 col-xl-3 p-2 appItem" data-id="{{$app.Id}}">
          <div
            class="card text-white
                    {{if eq $app.Status 0 }} bg-primary
                    {{else if eq $app.Status 1 }} bg-success
                    {{else if eq $app.Status 2 }} bg-danger
                    {{else if eq $app.Status 3 }} bg-secondary
                    {{end}}"
          >
            <div class="card-body">
              <div class="row">
                <div class="col-auto pe-0">
                  <span class="app-icon"
                    ><i class="bi bi-app"></i><img src="{{$app.IconUrl}}" alt="" width="48" height="48"
                  /></span>
                </div>
                <div class="col pe-0">
                  <h5 class="card-title {{if $app.Version}}mb-1{{end}}" style="word-break: break-all">
                    {{$app.Name}}
                  </h5>
                  {{if $app.Version}}
                  <div class="app-version">v{{$app.Version}}</div>
                  {{end}}
                </div>
                <div class="col-auto">
                  <div class="dropdown">
                    <a class="bi bi-three-dots-vertical py-1 px-2" data-bs-toggle="dropdown"></a>
                    <div class="dropdown-menu">
                      <a class="dropdown-item dropdownCreateFrom" x-app-name="{{$app.Name}}" x-app-id="{{$app.Id}}"
                        >Create from...</a
                      >
                      <a class="dropdown-item" href="{{$app.RenameUrl}}">Rename...</a>
                      <a class="dropdown-item" href="{{$app.ResignUrl}}" data-action="resign">Resign</a>
                      <a
                        class="dropdown-item"
                        href="{{$app.DeleteUrl}}"
                        data-action="delete"
                        data-confirm='Delete app "{{$app.Name}}"?'
                        >Delete</a
                      >
                    </div>
                  </div>
                </div>
              </div>
              <p class="card-text mb-2">
                {{if gt $app.TweakCount 0}}
                <a class="tweak-count" tabindex="0" role="button" data-bs-title="{{$app.TweakNames}}"
                  >{{$app.TweakCount}} tweaks</a
                >
                <br />
                {{end}} {{if eq $app.Status 1 }} {{$app.BundleId}} <br />
                {{end}} {{$app.ProfileName}}
                <!-- signed is clear from the green card and the install button -->
                {{if eq $app.Status 0 }} <br />
                Processing {{else if eq $app.Status 2 }} <br />
                Failed {{else if eq $app.Status 3 }} <br />
                Waiting {{end}}
              </p>
              <div class="card-footer-row">
                <span>{{$app.ModTime}}</span>
                <div class="card-actions">
                  {{if and (eq $app.Status 1) (not $app.IsMac) }}
                  <a class="btn btn-outline-light" href="{{$app.InstallUrl}}">Install</a>
                  {{end}} {{if ne $app.Status 1 }}
                  <a
                    class="btn btn-outline-light {{if lt (len $app.WorkflowUrl) 1}}disabled{{end}}"
                    href="{{$app.WorkflowUrl}}"
                    >Status</a
                  >
                  {{end}} {{if or (eq $app.Status 0) (eq $app.Status 3)}}
                  <a
                    class="btn btn-outline-light"
                    href="{{$app.TwoFactorUrl}}"
                    title="Submit 2FA"
                    aria-label="Submit 2FA"
                    ><i class="bi bi-key"></i
                  ></a>
                  {{end}} {{if or (eq $app.Status 1) (eq $app.Status 2)}}
                  <div class="dropdown">
                    <a
                      class="btn btn-outline-light dropdown-toggle"
                      data-bs-toggle="dropdown"
                      title="Download"
                      aria-label="Download"
                      ><i class="bi bi-download"></i
                    ></a>
                    <ul class="dropdown-menu">
                      {{if eq $app.Status 1 }}
                      <li><a class="dropdown-item" href="{{$app.DownloadSignedUrl}}">Signed</a></li>
                      {{end}}
                      <li><a class="dropdown-item" href="{{$app.DownloadUnsignedUrl}}">Original</a></li>
                      {{if gt $app.TweakCount 0}}
                      <li><a class="dropdown-item" href="{{$app.DownloadTweaksUrl}}">Tweaks</a></li>
                      {{end}}
                    </ul>
                  </div>
                  {{end}}
                </div>
              </div>
            </div>
          </div>
        </div>
        {{end}} {{end}}
      </div>
    </div>
  </body>

  <script type="module" src="/js/index.js"></script>
</html>
